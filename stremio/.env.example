# ─── Obligatoire ──────────────────────────────────────────────────────────
# Clé API TMDB (v3). Sans elle, aucun identifiant Stremio ne peut être résolu.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ─── Fortement recommandé ─────────────────────────────────────────────────
# URL publique de l'addon, telle que Stremio la voit. Les liens proxifiés
# sont absolus : sans cette valeur ils pointent 127.0.0.1 et ne marchent que
# sur la machine qui héberge l'addon.
#   ex: https://sora.mondomaine.fr   ou   http://192.168.1.20:7000
PUBLIC_URL=

# Secret de signature des liens proxifiés. S'il est vide, un secret est tiré
# au démarrage — ça fonctionne, mais tout lien déjà ouvert meurt à chaque
# redémarrage. Générer une fois :  openssl rand -hex 32
PROXY_SECRET=

# ─── Optionnel ────────────────────────────────────────────────────────────
PORT=7000

# Sources actives, séparées par des virgules. Vide = toutes.
#   movix, purstream, animesama, voiranime, nakanime
SCRAPERS=

# Langue des métadonnées TMDB (titres utilisés pour chercher sur les sites FR).
TMDB_LANGUAGE=fr-FR

# Budget de temps d'une source, puis d'une requête HTTP unitaire.
SCRAPER_TIMEOUT_MS=25000
HTTP_TIMEOUT_MS=12000

# Cache mémoire. Le TTL négatif s'applique aux résultats vides.
CACHE_TTL_MS=1200000
CACHE_NEGATIVE_TTL_MS=180000
CACHE_MAX_ENTRIES=2000

# Proxy intégré : réinjecte les Referer/Origin que Stremio ne transmet pas.
# Le couper fait tomber les hébergeurs qui les exigent en 403.
PROXY_ENABLED=true
PROXY_TTL_MS=21600000

# Teste chaque flux sans headers et ne le proxifie que s'il en a besoin.
# Mesuré : ~87 % des flux s'en passent, et ne coûtent alors aucune bande
# passante au serveur. Coûte ~3 s au premier appel pour un hôte inconnu, puis
# rien (verdict mémorisé par hôte). À activer dès qu'on héberge pour d'autres.
PROBE_DIRECT=false

# ─── Instance publique ────────────────────────────────────────────────────
# 0 = désactivé. Voir « Héberger publiquement » dans le README.
RATE_LIMIT_STREAM_PER_MIN=0
PROXY_MAX_CONCURRENT=0
# Nombre de reverse-proxies devant l'addon (1 derrière Caddy, 0 sinon).
# Ne jamais le monter sans reverse-proxy : ce serait croire un X-Forwarded-For
# écrit par le client lui-même.
TRUST_PROXY=0

# debug trace chaque requête sortante — indispensable pour diagnostiquer une
# source qui ne rend rien.
LOG_LEVEL=info
