# ─── Obligatoire ──────────────────────────────────────────────────────────
# Clé API TMDB (v3). Sans elle, aucun identifiant Stremio ne peut être résolu.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ─── Fortement recommandé ─────────────────────────────────────────────────
# URL publique de l'addon, telle que Stremio la voit. Les liens proxifiés
# sont absolus : sans cette valeur ils pointent 127.0.0.1 et ne marchent que
# sur la machine qui héberge l'addon.
#   ex: https://sora.mondomaine.fr   ou   http://192.168.1.20:7000
PUBLIC_URL=

# Secret de signature des liens proxifiés. S'il est vide, un secret est tiré
# au démarrage — ça fonctionne, mais tout lien déjà ouvert meurt à chaque
# redémarrage. Générer une fois :  openssl rand -hex 32
PROXY_SECRET=

# Jeton d'administration. S'il est défini, /admin/cache/clear l'exige dans
# l'en-tête X-Admin-Token ; vide, la route reste ouverte (pratique en local).
# À DÉFINIR dès que l'addon est exposé sur Internet.  openssl rand -hex 32
ADMIN_TOKEN=

# Domaine public, utilisé par docker-compose.public.yml (Caddy/HTTPS) et
# docker-compose.tunnel.yml. Doit pointer (DNS) sur cette machine.
#   ex: sora.mondomaine.fr
ADDON_DOMAIN=

# ─── AIOStreams auto-hébergé (optionnel) ───────────────────────────────────
# Décommenter ces deux lignes pour lancer AIOStreams à côté de l'addon, derrière
# le même Caddy (voir le service `aiostreams` dans docker-compose.public.yml et
# le fichier .env.aiostreams). Vide/absent = AIOStreams ne tourne pas.
#   COMPOSE_PROFILES active le service ; AIOSTREAMS_DOMAIN dit à Caddy quel
#   second sous-domaine publier en HTTPS (créer ce domaine sur DuckDNS, pointé
#   sur cette même machine).
# COMPOSE_PROFILES=aiostreams
# AIOSTREAMS_DOMAIN=mxfia19aio.duckdns.org

# ─── Optionnel ────────────────────────────────────────────────────────────
PORT=7000

# Sources actives, séparées par des virgules. Vide = toutes.
#   movix, purstream, animesama, voiranime, nakanime
SCRAPERS=

# Langue des métadonnées TMDB (titres utilisés pour chercher sur les sites FR).
TMDB_LANGUAGE=fr-FR

# Budget de temps d'une source, puis d'une requête HTTP unitaire.
SCRAPER_TIMEOUT_MS=25000
HTTP_TIMEOUT_MS=12000

# Cache mémoire. Le TTL négatif s'applique aux résultats vides.
CACHE_TTL_MS=1200000
CACHE_NEGATIVE_TTL_MS=180000
CACHE_MAX_ENTRIES=2000

# Proxy intégré : réinjecte les Referer/Origin que Stremio ne transmet pas.
# Le couper fait tomber les hébergeurs qui les exigent en 403.
PROXY_ENABLED=true
PROXY_TTL_MS=21600000

# Teste chaque flux sans headers et ne le proxifie que s'il en a besoin.
# Mesuré : ~87 % des flux s'en passent, et ne coûtent alors aucune bande
# passante au serveur. Coûte ~3 s au premier appel pour un hôte inconnu, puis
# rien (verdict mémorisé par hôte, 6 h).
#
# ATTENTION — ce que la sonde prouve, et ce qu'elle ne prouve pas. Elle
# interroge le CDN DEPUIS LE SERVEUR. Elle établit donc que le serveur peut
# lire le flux sans headers ; elle n'établit pas que le lecteur le pourra. Or
# ces URLs sont signées et portent régulièrement de quoi les lier à celui qui
# les a demandées : `sign` et `reg` chez Mail.ru, `ip` chez Streamtape, `asn`
# chez la famille Vidmoly. Un jeton frappé pour l'IP du serveur peut être
# refusé au téléphone.
#
# Donc : utile sur une instance dont les clients sortent par la même IP
# (usage domestique, VPN commun). Sur un serveur distant, c'est un pari, et
# le symptôme quand il est perdu, ce sont des erreurs de lecture sur des flux
# que /debug annonce pourtant joignables. En cas de doute, laisser à false :
# se tromper de ce côté ne coûte que de la bande passante.
PROBE_DIRECT=false

# ─── Instance publique ────────────────────────────────────────────────────
# 0 = désactivé. Voir « Héberger publiquement » dans le README.
RATE_LIMIT_STREAM_PER_MIN=0
PROXY_MAX_CONCURRENT=0
# Nombre de reverse-proxies devant l'addon (1 derrière Caddy, 0 sinon).
# Ne jamais le monter sans reverse-proxy : ce serait croire un X-Forwarded-For
# écrit par le client lui-même.
TRUST_PROXY=0

# Ouvre /debug (test d'une source à la demande) et /debug/live (console en
# direct : ce que fait le serveur pendant qu'on s'en sert depuis un autre
# appareil). Très utile pour régler, à laisser fermée sur une instance
# ouverte au public.
DEBUG_UI=false

# Où le journal de /debug/live survit aux redémarrages. Vide = rien n'est
# écrit et la console repart de zéro à chaque relance, ce qui est gênant
# justement quand on vient de redéployer pour corriger quelque chose.
# Le docker-compose pointe ce réglage sur un volume ; sans volume, écrire dans
# le conteneur ne servirait à rien.
LIVE_LOG_FILE=

# debug trace chaque requête sortante — indispensable pour diagnostiquer une
# source qui ne rend rien.
LOG_LEVEL=info
