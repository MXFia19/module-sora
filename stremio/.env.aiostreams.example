# ─── AIOStreams auto-hébergé (optionnel) ───────────────────────────────────
# Copier en .env.aiostreams. Ce fichier n'est chargé QUE dans le conteneur
# aiostreams (jamais dans l'addon), pour ne pas y mélanger les secrets.
#
# Pour activer AIOStreams, il faut EN PLUS mettre dans le .env principal :
#     COMPOSE_PROFILES=aiostreams
#     AIOSTREAMS_DOMAIN=mxfia19aio.duckdns.org
# (AIOSTREAMS_DOMAIN sert à Caddy pour publier le bon sous-domaine en HTTPS.)

# Clé de chiffrement des configurations. OBLIGATOIRE, 64 caractères hex.
# Générer une fois :  openssl rand -hex 32
# Ne jamais la changer une fois des configs créées : elles deviendraient
# illisibles.
SECRET_KEY=

# URL publique de l'instance, telle que le navigateur/Stremio la voit.
# OBLIGATOIRE. Doit correspondre à AIOSTREAMS_DOMAIN, en https.
# Sans elle, le bouton « Copy Install URL » ne génère aucun lien.
#   ex: https://mxfia19aio.duckdns.org
BASE_URL=

# Port interne. Laisser 3000 : c'est ce que le Caddyfile et le compose visent.
PORT=3000

# Base de données locale, sur le volume aiostreams_data (persistée).
DATABASE_URI=sqlite://./data/db.sqlite

# ─── Optionnel ─────────────────────────────────────────────────────────────
# Mot de passe pour protéger l'accès à la page de configuration. Fortement
# recommandé sur une instance ouverte au public.
# ADDON_PASSWORD=
